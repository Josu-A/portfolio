---
import ProjectCard from "@components/ProjectCard.astro";
import { projectImages } from "@data/project-images";
import { getTranslator, type Locale } from "@i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "projects");
const items = t("items", { returnObjects: true }) as Array<{
    description: string | string[];
    image?: string;
    link?: string;
    technologies: string;
    title: string;
}>;
const title = t("title");
const firstImageIndex = items.findIndex((project) => project.image);

const getProjectImage = (imageKey: string | undefined) => {
    if (!imageKey) {
        return undefined;
    }

    const image = projectImages[imageKey];

    if (!image) {
        throw new Error(`Missing project image: ${imageKey}`);
    }

    return image;
};
---

<section aria-labelledby="projects-title" class="py-20" id="projects">
    <h2
        class="mx-auto w-full max-w-5xl px-5 text-[clamp(var(--text-4xl),5vw,var(--text-6xl))] text-center text-balance sm:px-8"
        id="projects-title"
    >
        {title}
    </h2>
    <div class="mx-auto w-full max-w-7xl px-5 relative mt-16 sm:px-8">
        <div
            aria-hidden="true"
            class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-(--color-border) lg:block"
        ></div>
        <div class="grid grid-cols-1 gap-20 lg:gap-12">
            {items.map((project, index) => (
                <div class="relative grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_2rem_minmax(0,1fr)]">
                    <ProjectCard
                        {...project}
                        class:list={[
                            !(index % 2)
                                ? "lg:col-start-2 lg:col-end-4 lg:ml-10"
                                : "lg:col-start-1 lg:col-end-3 lg:mr-10",
                        ]}
                        eager={index === firstImageIndex}
                        image={getProjectImage(project.image)}
                        locale={locale}
                        reverse={index % 2 !== 0}
                    />
                    <span
                        aria-hidden="true"
                        class="absolute left-1/2 top-8 hidden size-4 -translate-x-1/2 rounded-full border-3 border-(--color-border) bg-(--color-background) lg:block"
                    ></span>
                </div>
            ))}
        </div>
    </div>
</section>
