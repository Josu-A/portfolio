---
import {
    defaultLocale,
    getTranslator,
    type Locale,
    localeCodes,
    localeMetadata,
    stripLocalePrefix,
} from "@i18n";
import ogImage from "@images/og-image.jpg";
import { Font, getImage } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { ClientRouter } from "astro:transitions";

interface Props {
    description?: string;
    locale?: Locale;
    namespace: string;
    noindex?: boolean;
    preloadSerif?: boolean;
    title?: string;
}

const {
    description: customDescription,
    locale = defaultLocale,
    namespace,
    noindex = false,
    preloadSerif = false,
    title: customTitle,
} = Astro.props;
const pagePath = stripLocalePrefix(Astro.url.pathname);
const alternatePagePath = pagePath.replace(/^\/|\/$/g, "") || "";
const t = getTranslator(locale, namespace);
const tCommon = getTranslator(locale, "common");
const description = customDescription ?? t("description");
const title = customTitle ?? t("title");
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const openGraphImage = await getImage({ format: "jpg", src: ogImage });
const openGraphImageURL = new URL(openGraphImage.src, Astro.site);
---

<link href="/favicon.ico" rel="icon" sizes="16x16 32x32 48x48" />
<Font cssVariable="--font-ibm-plex-sans" preload={[{ weight: 400 }]} />
<Font cssVariable="--font-fraunces" preload={preloadSerif} />
<Font cssVariable="--font-noto-sans-mono" />
<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
<meta charset="utf-8" />
<meta content={Astro.generator} name="generator" />

<meta content="width=device-width, initial-scale=1" name="viewport" />
<meta name="darkreader-lock" />

<title>{title}</title>
<meta content={title} name="title" />
<meta content={description} name="description" />
{noindex ? (
    <meta content="noindex" name="robots" />
) : (
    <link href={canonicalURL} rel="canonical" />
)}

<meta content="website" property="og:type" />
<meta content="Josu’s Space" property="og:site_name" />
{!noindex && <meta content={canonicalURL} property="og:url" />}
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={openGraphImageURL} property="og:image" />
<meta content={openGraphImage.attributes.width} property="og:image:width" />
<meta content={openGraphImage.attributes.height} property="og:image:height" />
<meta content={tCommon("ogImageAlt")} property="og:image:alt" />
<meta content={localeMetadata[locale].openGraph} property="og:locale" />
{localeCodes
    .filter((alternateLocale) => alternateLocale !== locale)
    .map((alternateLocale) => (
        <meta
            content={localeMetadata[alternateLocale].openGraph}
            property="og:locale:alternate"
        />
    ))}

<meta content="summary_large_image" name="twitter:card" />
{!noindex && (
    <>
        {localeCodes.map((alternateLocale) => (
            <link
                href={getAbsoluteLocaleUrl(alternateLocale, alternatePagePath)}
                hreflang={alternateLocale}
                rel="alternate"
            />
        ))}
        <link
            href={
                alternatePagePath
                    ? getAbsoluteLocaleUrl(defaultLocale, alternatePagePath)
                    : new URL("/", Astro.site)
            }
            hreflang="x-default"
            rel="alternate"
        />
    </>
)}

<script is:inline>
    try {
        document.documentElement.dataset.theme =
            localStorage.getItem("theme") || "system";
    } catch {
        document.documentElement.dataset.theme = "system";
    }
</script>
<script src="@scripts/theme.ts"></script>

<ClientRouter />
