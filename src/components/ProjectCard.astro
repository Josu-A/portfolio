---
import type { ImageMetadata } from "astro";

import { getTranslator, type Locale } from "@i18n";
import ExternalLinkIcon from "@images/external-link.svg";
import { Image } from "astro:assets";
import sharp from "sharp";

interface Props {
    class?: string;
    description: string | string[];
    eager?: boolean;
    image?: ImageMetadata;
    link?: string;
    locale: Locale;
    reverse?: boolean;
    technologies: string;
    title: string;
}

const {
    class: className,
    description,
    eager = false,
    image,
    link,
    locale,
    reverse = false,
    technologies,
    title,
} = Astro.props;

const descriptions = Array.isArray(description) ? description : [description];

const t = getTranslator(locale, "projects");
const viewProjectText = t("viewProject");

const imagePath = image && (image as ImageMetadata & { fsPath: string }).fsPath;

const createBlurPlaceholder = async (path: string) => {
    const { data, info } = await sharp(path)
        .resize(16)
        .webp({ quality: 50 })
        .toBuffer({ resolveWithObject: true });
    const { isOpaque } = await sharp(path).stats();
    const solidEdges = isOpaque
        ? "<feComponentTransfer><feFuncA type='discrete' tableValues='1 1'/></feComponentTransfer>"
        : "";
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${info.width} ${info.height}'><filter id='b' color-interpolation-filters='sRGB'><feGaussianBlur stdDeviation='1'/>${solidEdges}</filter><image href='data:image/webp;base64,${data.toString("base64")}' width='100%' height='100%' preserveAspectRatio='none' filter='url(#b)'/></svg>`;

    return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const placeholder = imagePath && (await createBlurPlaceholder(imagePath));
---

<article
    class:list={[
        "relative z-0 flex flex-col py-2 transition-transform duration-hover hover:z-10 motion-safe:hover:scale-[1.03] lg:block",
        !image && "max-w-xl",
        className,
    ]}
>
    <h3 class="mb-3 text-3xl font-normal text-balance">{title}</h3>
    {image && (
        <div
            class:list={[
                "order-first mb-4 lg:mt-1 lg:mb-2 lg:w-2/5",
                reverse ? "lg:float-left lg:mr-6" : "lg:float-right lg:ml-6",
            ]}
            data-placeholder
            style={`background: url("${placeholder}") center / contain no-repeat`}
        >
            <Image
                alt=""
                class="w-full object-contain max-h-48 opacity-0 drop-shadow-xl transition-opacity duration-300 lg:max-h-none"
                priority={eager}
                src={image}
            />
            <noscript>
                <style>
                    [data-placeholder] img {
                        opacity: 1;
                    }
                </style>
            </noscript>
        </div>
    )}
    <div class="max-w-2xl text-(--color-secondary) space-y-3">
        {descriptions.map((p) => (
            <p>{p}</p>
        ))}
    </div>
    <div class="mt-4 flex text-xs items-center justify-between gap-8 lg:clear-both">
        <p class="font-mono uppercase tracking-tight text-(--color-muted)">
            {technologies}
        </p>
        {link && (
            <a
                class="group flex shrink-0 items-center gap-2 whitespace-nowrap text-(--color-accent) transition-colors duration-hover hover:text-(--color-foreground)"
                href={link}
            >
                <span class="font-mono uppercase tracking-tight">
                    {viewProjectText}
                </span>
                <ExternalLinkIcon
                    aria-hidden="true"
                    class="size-2 shrink-0 self-start"
                />
            </a>
        )}
    </div>
</article>

<script>
    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>("[data-placeholder]")
            .forEach((wrapper) => {
                const image = wrapper.querySelector("img");

                if (!image) {
                    return;
                }

                const reveal = () => {
                    image.addEventListener(
                        "transitionend",
                        () => wrapper.style.removeProperty("background"),
                        { once: true },
                    );
                    image.classList.remove("opacity-0");
                };

                if (image.complete && image.naturalWidth > 0) {
                    reveal();
                } else {
                    image.addEventListener("load", reveal, { once: true });
                }
            });
    });
</script>
