---
import type { ImageMetadata, ImageOutputFormat, ImageQuality } from "astro";

import { Image } from "astro:assets";
import sharp from "sharp";

interface Props {
    alt: string;
    class?: string;
    draggable?: boolean;
    fade?: boolean;
    fit: "contain" | "cover";
    format?: ImageOutputFormat;
    height?: number;
    imageClass?: string;
    loading?: "eager" | "lazy";
    position?: string;
    priority?: boolean;
    quality?: ImageQuality;
    src: ImageMetadata;
    width?: number;
}

const {
    alt,
    class: className,
    draggable,
    fade = true,
    fit,
    format,
    height,
    imageClass,
    loading,
    position = "center",
    priority,
    quality,
    src,
    width,
} = Astro.props;

const imagePath = (src as ImageMetadata & { fsPath: string }).fsPath;

const createBlurPlaceholder = async (path: string) => {
    const { data, info } = await sharp(path)
        .resize(16)
        .webp({ quality: 50 })
        .toBuffer({ resolveWithObject: true });
    const { isOpaque } = await sharp(path).stats();
    const solidEdges = isOpaque
        ? "<feComponentTransfer><feFuncA type='discrete' tableValues='1 1'/></feComponentTransfer>"
        : "";
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${info.width} ${info.height}'><filter id='b' color-interpolation-filters='sRGB'><feGaussianBlur stdDeviation='1'/>${solidEdges}</filter><image href='data:image/webp;base64,${data.toString("base64")}' width='100%' height='100%' preserveAspectRatio='none' filter='url(#b)'/></svg>`;

    return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const placeholder = await createBlurPlaceholder(imagePath);
---

<div
    class={className}
    data-placeholder
    style={`background: url("${placeholder}") ${position} / ${fit} no-repeat`}
>
    <Image
        alt={alt}
        class:list={[
            imageClass,
            "opacity-0",
            fade && "duration-300 motion-safe:transition-opacity",
        ]}
        draggable={draggable}
        format={format}
        height={height}
        loading={loading}
        priority={priority}
        quality={quality}
        src={src}
        width={width}
    />
    <noscript>
        <style>
            [data-placeholder] img {
                opacity: 1;
            }
        </style>
    </noscript>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>("[data-placeholder]")
            .forEach((wrapper) => {
                const image = wrapper.querySelector("img");

                if (!image) {
                    return;
                }

                const removePlaceholder = () =>
                    wrapper.style.removeProperty("background");

                const reveal = () => {
                    if (
                        parseFloat(getComputedStyle(image).transitionDuration)
                    ) {
                        image.addEventListener(
                            "transitionend",
                            removePlaceholder,
                            { once: true },
                        );
                    } else {
                        removePlaceholder();
                    }
                    image.classList.remove("opacity-0");
                };

                if (image.complete) {
                    reveal();
                } else {
                    image.addEventListener("load", reveal, { once: true });
                    image.addEventListener("error", reveal, { once: true });
                }
            });
    });
</script>
