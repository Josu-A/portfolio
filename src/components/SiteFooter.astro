---
import SocialLink from "@components/SocialLink.astro";
import { socialLinks } from "@data/social-links";
import { getTranslator, type Locale } from "@i18n";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslator(locale, "common");
const text = t("footer", { year: new Date().getFullYear() });
---

<footer class="mx-auto mt-auto flex flex-col w-full max-w-5xl shrink-0 justify-between items-center gap-4 px-5 pb-8 pt-4 text-xs font-sans uppercase text-(--color-muted) sm:flex-row sm:px-8">
    <p>{text}</p>
    <div class="flex min-w-0 flex-wrap items-center gap-x-6 gap-y-3 justify-around sm:justify-end">
        {socialLinks.map((socialLink) => (
            <SocialLink {...socialLink} />
        ))}
    </div>
</footer>
